---
import BaseLayout from '../layouts/BaseLayout.astro';

// ═══════════════════════════════════════════════════════════
//  EDIT YOUR ABOUT PAGE TEXT BELOW
//
//  Just change the text between the backticks (` `)
//  You can use & normally — no need for &amp;
//  For links use:      <a href="URL">link text</a>
//  For bold text use:  <strong>bold text</strong>
// ═══════════════════════════════════════════════════════════

const introText = `Hi! I'm a college sophomore who is still a little unsure about his college major. I love working on things related to systems theory, applied physics and machine intelligence.`;

const sections = [
  {
    label: "Some professional things",
    paragraphs: [
      `I conduct serious independent AI research, focused on the structural questions related to the emergence of machine intelligence itself and how we can scale it and understand it better for sake of our civilisation — questions too fundamental and long-horizon to thrive inside a company with a product roadmap or a research lab with bureaucratic constraints.`,
      `I also run a philanthropy organisation grounded in hits-based giving, the idea that philanthropic impact, like venture returns, is deeply skewed. Most interventions do little. A small number matters enormously. The goal is to find and fund those.`,
    ],
  },
  {
    label: "Building",
    paragraphs: [
      `I'm currently building <strong>[Startup]</strong> — more details soon. I'm also a venture builder at <strong>Drexel VCC</strong>, where I work with founders at the earliest and most uncertain stage of company formation.`,
    ],
  },
  {
    label: "Writing & Investing",
    paragraphs: [
      `I write about global macro and technology investing on <a href="https://siliconmacro.substack.com" target="_blank" rel="noopener">Substack</a>. My focus is on structural themes — how interest rate regimes shape valuations, how dollar cycles affect emerging market technology, and where durable asymmetries live.`,
    ],
  },
  {
    label: "Startup Consulting",
    paragraphs: [
      `I work with a small number of startups on growth strategy, go-to-market, business model design, and financing. I bring both an operator's instinct and an investor's eye to every engagement.`,
      `If you're working on something early and want a thought partner, <a href="https://calendly.com/vishwadeep" target="_blank" rel="noopener">book an intro call</a>.`,
    ],
  },
];
---

<BaseLayout title="About" description="About Vishwadeep Balakrishnan — independent AI researcher, founder, and investor.">
  <main>
    <div class="about-wrap">

      <div class="page-hed fade-up fade-up-0">
        <span class="page-hed-label">About</span>
        <h1>First principles<br><em>or bust.</em></h1>
      </div>

      <p class="about-lede fade-up fade-up-1" set:html={introText} />

      {sections.map((section, i) => (
        <div class={`about-section fade-up fade-up-${i + 2}`}>
          <span class="about-section-label">{section.label}</span>
          {section.paragraphs.map((text) => (
            <p set:html={text} />
          ))}
        </div>
      ))}

    </div>
  </main>
</BaseLayout>
