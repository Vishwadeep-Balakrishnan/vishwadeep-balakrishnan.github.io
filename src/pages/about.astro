---
import BaseLayout from '../layouts/BaseLayout.astro';

// ═══════════════════════════════════════════════════════════
//  EDIT YOUR ABOUT PAGE TEXT BELOW
//
//  Just change the text between the backticks (` `)
//  You can use & normally — no need for &amp;
//  For links use:      <a href="URL">link text</a>
//  For bold text use:  <strong>bold text</strong>
// ═══════════════════════════════════════════════════════════

const introText = `Hi! I'm a college sophomore who is still a little unsure about his college major. I love working on things related to systems theory, applied physics and machine intelligence.`;

const sections = [
  {
    label: "Some work-related things",
    paragraphs: [
      `I do independent research on the foundational questions of machine intelligence or the buzzword, "AI" — emergence, scaling, interpretability.`,
      `In a previous life, I discovered a novel <a href"https://www.ncbi.nlm.nih.gov/nuccore/ok606117">bacteria</a> and conducted research in the area of nanotechnology, Surface Acoustic Wave sensors, designed an experiment for the DESY particle accelerator, and represented India at Regeneron ISEF with a novel nanomaterial that I discovered to remediate carcinogens from water.`,
      
    ],
  },
  {
    label: "Advocacy",
    paragraphs: [
      `I also run a philanthropy organisation grounded in high-risk, high-reward giving, the idea that philanthropic impact, like venture returns, is deeply skewed. Most interventions do little. A small number matters enormously. The goal is to find and fund those.`,
    ],
  },
  {
    label: "Writing & Investing",
    paragraphs: [
      `I write about global macro and technology investing on <a href="https://siliconmacro.substack.com" target="_blank" rel="noopener">Substack</a>. My focus is mostly on writing about investing in technology companies across the world and global macro commentary paired with identifying trading opportunities across rates, fixed income, FX, equity indices and macro volatility.`,
    ],
  },
  {
    label: "Startup Consulting",
    paragraphs: [
      `I partner with early-stage founders on the hardest pre-PMF problems: who to sell to first, how to reach them, and how to build a distribution motion that compounds. I also help with fundraising — from shaping the narrative to reviewing decks to thinking through what VCs to approach.`,
      `If you're at that stage and want a partner, <a href="https://calendly.com/vishwadeep" target="_blank" rel="noopener">book an intro call</a>.`,
    ],
  },
];
---

<BaseLayout title="About" description="About Vishwadeep Balakrishnan — independent AI researcher, founder, and investor.">
  <main>
    <div class="about-wrap">

      <div class="page-hed fade-up fade-up-0">
        <span class="page-hed-label">About</span>
        <h1>First principles<br><em>or bust.</em></h1>
      </div>

      <p class="about-lede fade-up fade-up-1" set:html={introText} />

      {sections.map((section, i) => (
        <div class={`about-section fade-up fade-up-${i + 2}`}>
          <span class="about-section-label">{section.label}</span>
          {section.paragraphs.map((text) => (
            <p set:html={text} />
          ))}
        </div>
      ))}

    </div>
  </main>
</BaseLayout>
