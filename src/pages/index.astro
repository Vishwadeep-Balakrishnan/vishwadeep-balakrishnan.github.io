---
import BaseLayout from '../layouts/BaseLayout.astro';

const description = 'Independent AI researcher, founder, and investor.';
---

<BaseLayout title="Vishwadeep Balakrishnan" description={description} isHome={true}>

  <div class="page-border">
  <main>
    <section class="home-board fade-up fade-up-0">

      <div class="board-grid">

        <div class="board-card fade-up fade-up-1">
          <span class="card-num">01</span>
          <span class="card-label">Research</span>
          <div class="card-body">
            <p>My current research interests lie primarily in the theory of intelligence and learning, model architecture, and agentic AI systems. I am currently working on developing an event-triggered external memory architecture for AI agents to improve their accuracy and efficiency.</p>
            <a href="/ideas/" class="card-link">Read my essays <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h8M6 2l4 4-4 4"/></svg></a>
          </div>
        </div>

        <div class="board-card fade-up fade-up-2">
          <span class="card-num">02</span>
          <span class="card-label">Advocacy</span>
          <div class="card-body">
            <p>I run <a href="https://speccommons.vercel.app" target="_blank" rel="noopener">Speculative Commons</a> — we find asymmetric philanthropic bets that matter most before anyone else sees them, and make sure the right money follows..</p>
          </div>
        </div>

        <div class="board-card fade-up fade-up-3">
          <span class="card-num">03</span>
          <span class="card-label">Building</span>
          <div class="card-body">
            <p>Currently building <strong>[Startup]</strong> — and serving as a venture builder at <strong>Drexel VCC</strong>, where we help founders develop robust businesses at the earliest stages.</p>
          </div>
        </div>

        <div class="board-card fade-up fade-up-4">
          <span class="card-num">04</span>
          <span class="card-label">Writing</span>
          <div class="card-body">
            <p>I write Silicon Macro on Substack, A research newsletter covering global macro and equities. My focus spans the entire Technology, Media, &amp; Telecom value chain, alongside monetary policy, capital flows, fixed income, FX dynamics, and broader equity indices.</p>
            <a href="https://siliconmacro.substack.com" target="_blank" rel="noopener" class="card-link">Read on Substack <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h8M6 2l4 4-4 4"/></svg></a>
          </div>
        </div>

      </div>

      <div class="board-card board-card--full fade-up fade-up-5">
        <span class="card-num">05</span>
        <span class="card-label">Consulting</span>
        <div class="card-body">
          <p>I help startups with growth strategy, go-to-market, business model design, and financing — bringing both operator and investor perspectives to every engagement.</p>
          <a href="https://calendly.com/vishwadeep" target="_blank" rel="noopener" class="card-link">Book an intro call <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 6h8M6 2l4 4-4 4"/></svg></a>
        </div>
      </div>

    </section>

    <footer class="home-footer">
      <p class="footer-copy">&copy; 2025</p>
      <div class="footer-socials">
        <a href="https://twitter.com/vishwadeep" target="_blank" rel="noopener">Twitter</a>
        <a href="https://linkedin.com/in/vishwadeep" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://siliconmacro.substack.com" target="_blank" rel="noopener">Substack</a>
      </div>
    </footer>

  </main>
  </div>

</BaseLayout>
