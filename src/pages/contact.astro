---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Get in touch with Vishwadeep Balakrishnan.">
  <main>
    <div class="contact-wrap">

      <div class="page-hed fade-up fade-up-0">
        <span class="page-hed-label">Contact</span>
        <h1>Let's <em>talk.</em></h1>
      </div>

      <p class="contact-lede fade-up fade-up-1">
        I'm best reached by email and twitter. I try to reply to every message within 24 hours,
        though sometimes it might take a bit more than that. If you're a founder,
        researcher, or someone who does things most people around you never did — I'm especially glad to hear from you.
      </p>

      <div class="contact-rows fade-up fade-up-2">

        <div class="contact-row">
          <span class="contact-row-label">Email</span>
          <span class="contact-row-val">
            <a href="mailto:vishwadeepb456@gmail.com">vishwadeepb456@gmail.com</a>
          </span>
        </div>

        <div class="contact-row">
          <span class="contact-row-label">Intro call</span>
          <span class="contact-row-val">
            <a href="https://calendly.com/vishwadeepb456/new-meeting" target="_blank" rel="noopener">Book on Calendly →</a>
          </span>
        </div>

        <div class="contact-row">
          <span class="contact-row-label">Twitter</span>
          <span class="contact-row-val">
            <a href="https://x.com/vshdeep" target="_blank" rel="noopener">@vshdeep</a>
          </span>
        </div>

        <div class="contact-row">
          <span class="contact-row-label">LinkedIn</span>
          <span class="contact-row-val">
            <a href="https://linkedin.com/in/vishwadeep" target="_blank" rel="noopener">linkedin.com/in/vishwadeep</a>
          </span>
        </div>

        <div class="contact-row">
          <span class="contact-row-label">Substack</span>
          <span class="contact-row-val">
            <a href="https://siliconmacro.substack.com" target="_blank" rel="noopener">substack.com/@vishwadeep</a>
          </span>
        </div>

      </div>

    </div>
  </main>
</BaseLayout>
